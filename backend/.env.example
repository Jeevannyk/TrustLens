GEMINI_API_KEY=
# Optional: comma-separated list of multiple keys (e.g. one per teammate, or
# multiple of your own projects) to rotate through when one hits its free-tier
# quota. Overrides GEMINI_API_KEY if set. Example:
# GEMINI_API_KEYS=key-one,key-two,key-three
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_SAFE_BROWSING_API_KEY=
# Analyses allowed per client IP per minute (0 = no limit).
# ANALYZE_RATE_PER_MIN=6
# Seconds an identical analysis is served from memory instead of calling Gemini (0 = off).
# CACHE_TTL_SECONDS=600
# Set to 1 only behind a reverse proxy you control; then the client IP is read from X-Forwarded-For.
# TRUST_PROXY=0
